<!--
  Decoder :: pfSense / OPNsense filterlog (CSV over syslog)
  Consumed by  : wazuh/custom-rules/firewall/001-perimeter-and-egress.xml

  Sample IPv4 TCP line:
  <134>Mar 12 10:04:11 fw01 filterlog: 5,,,1000000103,igb0,match,block,in,4,0x0,,63,54321,0,DF,6,tcp,60,203.0.113.10,10.10.5.20,44231,3389,0,S,1234567890,,64240,,mss;sackOK;TS;nop;wscale

  Field order (IPv4): rulenr,subrulenr,anchor,tracker,interface,reason,action,direction,
                      ipversion,tos,ecn,ttl,id,offset,flags,protoid,proto,length,src,dst,srcport,dstport
-->
<decoder name="pfsense-filterlog">
  <program_name>^filterlog$</program_name>
</decoder>

<decoder name="pfsense-filterlog-ipv4-tcpudp">
  <parent>pfsense-filterlog</parent>
  <regex offset="after_parent">^\d*,\S*,\S*,(\d+),(\S+),\S+,(\w+),(\w+),4,\S*,\S*,\d*,\d*,\d*,\S*,\d*,(\w+),\d+,(\S+),(\S+),(\d+),(\d+)</regex>
  <order>id,interface,action,direction,protocol,srcip,dstip,srcport,dstport</order>
</decoder>

<decoder name="pfsense-filterlog-ipv4-other">
  <parent>pfsense-filterlog</parent>
  <regex offset="after_parent">^\d*,\S*,\S*,(\d+),(\S+),\S+,(\w+),(\w+),4,\S*,\S*,\d*,\d*,\d*,\S*,\d*,(\w+),\d+,(\S+),(\S+)$</regex>
  <order>id,interface,action,direction,protocol,srcip,dstip</order>
</decoder>

<decoder name="pfsense-filterlog-ipv6">
  <parent>pfsense-filterlog</parent>
  <regex offset="after_parent">^\d*,\S*,\S*,(\d+),(\S+),\S+,(\w+),(\w+),6,\S*,\S*,\d*,(\w+),\d*,(\S+),(\S+),(\d+),(\d+)</regex>
  <order>id,interface,action,direction,protocol,srcip,dstip,srcport,dstport</order>
</decoder>
