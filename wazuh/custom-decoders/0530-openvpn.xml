<!--
  Decoder :: OpenVPN server log
  Samples:
    Mar 12 10:04:11 vpn01 openvpn[1421]: 203.0.113.10:51514 TLS: Username/Password authentication succeeded for username 'jdoe'
    Mar 12 10:04:19 vpn01 openvpn[1421]: 203.0.113.77:44120 TLS Auth Error: Auth Username/Password verification failed for peer
    Mar 12 10:05:02 vpn01 openvpn[1421]: jdoe/203.0.113.10:51514 MULTI_sva: pool returned IPv4=10.8.0.6
-->
<decoder name="openvpn">
  <program_name>^openvpn$</program_name>
</decoder>

<decoder name="openvpn-auth-success">
  <parent>openvpn</parent>
  <regex offset="after_parent">^(\S+):(\d+) TLS: Username/Password authentication succeeded for username '(\S+)'</regex>
  <order>srcip,srcport,dstuser</order>
</decoder>

<decoder name="openvpn-auth-failed">
  <parent>openvpn</parent>
  <regex offset="after_parent">^(\S+):(\d+) TLS Auth Error: Auth Username/Password verification failed</regex>
  <order>srcip,srcport</order>
</decoder>

<decoder name="openvpn-pool-assign">
  <parent>openvpn</parent>
  <regex offset="after_parent">^(\S+)/(\S+):(\d+) MULTI_sva: pool returned IPv4=(\S+)</regex>
  <order>dstuser,srcip,srcport,dstip</order>
</decoder>

<decoder name="openvpn-tls-error">
  <parent>openvpn</parent>
  <regex offset="after_parent">^(\S+):(\d+) TLS Error: (\.+)$</regex>
  <order>srcip,srcport,status</order>
</decoder>
