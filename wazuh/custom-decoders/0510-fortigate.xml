<!--
  Decoder :: FortiGate key=value syslog
  Sample:
  date=2026-03-12 time=10:04:11 devname="fgt01" devid="FG100E" logid="0000000013" type="traffic"
  subtype="forward" level="notice" srcip=10.10.5.20 srcport=51514 dstip=203.0.113.10 dstport=443
  action="deny" policyid=12 service="HTTPS" user="jdoe" app="Unknown" sentbyte=0 rcvdbyte=0
-->
<decoder name="fortigate">
  <prematch>devname=|devid=</prematch>
</decoder>

<!--
  FortiGate emits key=value, so each field is extracted by its own child decoder.
  This keeps parsing order independent and tolerant of firmware field changes.
-->
<decoder name="fortigate-srcip">
  <parent>fortigate</parent>
  <regex>srcip=(\S+)</regex>
  <order>srcip</order>
</decoder>

<decoder name="fortigate-dstip">
  <parent>fortigate</parent>
  <regex>dstip=(\S+)</regex>
  <order>dstip</order>
</decoder>

<decoder name="fortigate-ports">
  <parent>fortigate</parent>
  <regex>srcport=(\d+)\s+dstip=\S+\s+dstport=(\d+)</regex>
  <order>srcport,dstport</order>
</decoder>

<decoder name="fortigate-action">
  <parent>fortigate</parent>
  <regex>action="(\w+)"</regex>
  <order>action</order>
</decoder>

<decoder name="fortigate-user">
  <parent>fortigate</parent>
  <regex>user="(\S+)"</regex>
  <order>dstuser</order>
</decoder>

<decoder name="fortigate-subtype">
  <parent>fortigate</parent>
  <regex>subtype="(\w+)"</regex>
  <order>status</order>
</decoder>
