<group name="authentication,custom,bruteforce,">
  <rule id="122001" level="5">
    <if_group>authentication_failed</if_group>
    <description>Authentication failure recorded for custom spray detection pipeline</description>
    <group>auth_failure,</group>
  </rule>

  <rule id="122002" level="10" frequency="8" timeframe="120">
    <if_matched_sid>122001</if_matched_sid>
    <same_field>srcip</same_field>
    <different_field>user</different_field>
    <description>Potential password spray from one source against multiple users</description>
    <mitre>
      <id>T1110.003</id>
    </mitre>
    <group>attack.credential_access,password_spray,</group>
  </rule>

  <rule id="122003" level="14" frequency="1" timeframe="300">
    <if_matched_sid>122002</if_matched_sid>
    <if_group>authentication_success</if_group>
    <same_field>srcip</same_field>
    <description>Password spray followed by successful authentication from same source</description>
    <mitre>
      <id>T1110.003</id>
      <id>T1078</id>
    </mitre>
    <group>attack.credential_access,valid_accounts,auth_spray_success,</group>
  </rule>
</group>
