<!--
  Windows :: Credential Access
  Rule ID range : 120100-120199
  Data source   : Sysmon (Microsoft-Windows-Sysmon/Operational), Security channel 4662/4769
  Requires      : Sysmon with ProcessAccess (EID 10) enabled - see wazuh/config/sysmon-requirements.md
  MITRE         : TA0006 Credential Access
-->
<group name="windows,sysmon,credential_access,custom,">

  <!-- LSASS handle request with a dump-capable access mask (Mimikatz family) -->
  <rule id="120100" level="12">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1410|1438|143a|1fffff|101010)$</field>
    <description>LSASS memory access with credential-dump access mask by $(win.eventdata.sourceImage)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>attack.credential_access,lsass_access,</group>
  </rule>

  <!-- Allowlist: platform processes that legitimately open LSASS handles -->
  <rule id="120101" level="0">
    <if_sid>120100</if_sid>
    <field name="win.eventdata.sourceImage" type="pcre2">(?i)\\(MsMpEng|wazuh-agent|SenseIR|CSFalconService|taskmgr|lsass)\.exe$</field>
    <description>LSASS access from an allowlisted platform process - suppressed</description>
    <group>allowlist,lsass_access,</group>
  </rule>

  <!-- comsvcs.dll MiniDump: LOLBin credential dump -->
  <rule id="120102" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)comsvcs\.dll.{0,40}minidump</field>
    <description>LSASS dumped via comsvcs.dll MiniDump on $(win.system.computer)</description>
    <mitre>
      <id>T1003.001</id>
      <id>T1218.011</id>
    </mitre>
    <group>attack.credential_access,lolbin,</group>
  </rule>

  <!-- Offline credential store export -->
  <rule id="120103" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\b(reg(\.exe)?\s+save|esentutl.{0,40}ntds\.dit|ntdsutil)\b.{0,80}\b(sam|system|security|ntds)\b</field>
    <description>Credential store export attempt (SAM/SYSTEM/NTDS) on $(win.system.computer)</description>
    <mitre>
      <id>T1003.002</id>
      <id>T1003.003</id>
    </mitre>
    <group>attack.credential_access,registry_dump,</group>
  </rule>

  <rule id="120104" level="14" frequency="2" timeframe="600">
    <if_matched_sid>120103</if_matched_sid>
    <same_field>win.system.computer</same_field>
    <description>Repeated credential store export on $(win.system.computer) - probable domain credential theft</description>
    <mitre>
      <id>T1003.003</id>
    </mitre>
    <group>attack.credential_access,correlation,</group>
  </rule>

  <!-- DCSync: directory replication rights used from a non-DC principal -->
  <rule id="120105" level="14">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.properties" type="pcre2">(?i)1131f6aa-9c07-11d1-f79f-00c04fc2dcd2|1131f6ad-9c07-11d1-f79f-00c04fc2dcd2|89e95b76-444d-4c62-991a-0facbeda640c</field>
    <description>DCSync replication rights exercised by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1003.006</id>
    </mitre>
    <group>attack.credential_access,dcsync,</group>
  </rule>

  <!-- Kerberoasting: RC4 downgrade on service ticket requests -->
  <rule id="120106" level="8">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <field name="win.eventdata.serviceName" type="pcre2">^(?!krbtgt$)(?!.*\$$).+</field>
    <description>RC4-downgraded Kerberos service ticket requested for $(win.eventdata.serviceName)</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>attack.credential_access,kerberoast,</group>
  </rule>

  <rule id="120107" level="13" frequency="8" timeframe="300">
    <if_matched_sid>120106</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>Kerberoasting burst: 8+ RC4 service tickets from $(win.eventdata.ipAddress) in 5 minutes</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>attack.credential_access,kerberoast,correlation,</group>
  </rule>

  <!-- Browser and vault secret harvesting -->
  <rule id="120108" level="11">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(Login Data|Local State|logins\.json|key4\.db|vaultcmd|cmdkey\s+/list)</field>
    <description>Browser or credential-vault material accessed by $(win.eventdata.image)</description>
    <mitre>
      <id>T1555.003</id>
    </mitre>
    <group>attack.credential_access,browser_creds,</group>
  </rule>

  <!-- AS-REP roasting: preauth-disabled accounts requested (4768 with 0x17 and no preauth) -->
  <rule id="120109" level="12">
    <if_group>windows</if_group>
    <field name="win.system.eventID">^4768$</field>
    <field name="win.eventdata.preAuthType">^0$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <description>AS-REP roastable ticket issued for $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1558.004</id>
    </mitre>
    <group>attack.credential_access,asreproast,</group>
  </rule>

</group>
